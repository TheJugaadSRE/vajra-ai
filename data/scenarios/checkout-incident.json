      "source": "Dynatrace"
    },
    {
      "delay_ms": 500,
      "eventType": "ALERT_TRIGGERED",
      "service": "checkout-service",
      "environment": "production",
      "severity": "high",
      "alert": "Latency increase (p99 > 2.5s)",

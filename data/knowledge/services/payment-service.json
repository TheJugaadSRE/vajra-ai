{
  "service": "payment-service",
  "owner": "Payments Team",
  "oncall": "payments-oncall@vajra.example (PagerDuty: payments-primary)",
  "criticality": "tier-1",
  "revenue_per_minute_downtime_usd": 6800,
  "dependencies": [
    { "service": "payment-db", "type": "sync", "criticality": "critical" },
